# Normalize reviewable text while keeping platform launchers native on Windows.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
*.patch text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Research artifacts and Planetoid dataset files are opaque binary evidence.
*.pdf binary
case-studies/gcn-cora/experiment/upstream/gcn/data/* binary
